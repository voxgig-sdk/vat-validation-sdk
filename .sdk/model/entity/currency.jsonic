# Entity: currency

main: kit: entity: currency: {

  alias: field: {}

  fields: [
    {
      name: "name"
      req: true
      type: "`$STRING`"
    }
    {
      name: "symbol"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "currency"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/currencies"
          parts: [
            "currencies"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
