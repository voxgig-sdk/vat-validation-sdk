{
  "openapi": "3.1.0",
  "info": {
    "title": "Vatcomply API",
    "version": "1.0.0",
    "description": "API for automated VAT compliance and currency conversion.",
    "contact": {
      "name": "VATcomply",
      "url": "https://www.vatcomply.com",
      "email": "support@vatcomply.com"
    },
    "license": {
      "name": "MIT License",
      "url": "https://github.com/madisvain/vatcomply/blob/master/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://api.vatcomply.com"
    }
  ],
  "paths": {
    "/countries": {
      "get": {
        "operationId": "vatcomply_api_countries",
        "summary": "Get list of countries",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CountrySchema"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "Fetches a list of countries with their details."
      }
    },
    "/currencies": {
      "get": {
        "operationId": "vatcomply_api_get_currencies",
        "summary": "Get list of supported currencies",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/CurrencySchema"
                  },
                  "title": "Response",
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/geolocate": {
      "get": {
        "operationId": "vatcomply_api_geolocate",
        "summary": "Geolocate by IP",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeolocateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/iban": {
      "get": {
        "operationId": "vatcomply_api_validate_iban",
        "summary": "Validate Iban",
        "parameters": [
          {
            "in": "query",
            "name": "iban",
            "schema": {
              "maxLength": 34,
              "title": "IBAN",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateIBANResponseSchema"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/vat": {
      "get": {
        "operationId": "vatcomply_api_validate_vat",
        "summary": "Validate Vat",
        "parameters": [
          {
            "in": "query",
            "name": "vat_number",
            "schema": {
              "title": "Vat Number",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateVATResponseSchema"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rates": {
      "get": {
        "operationId": "vatcomply_api_rates",
        "summary": "Rates",
        "parameters": [
          {
            "in": "query",
            "name": "base",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "EUR",
              "title": "Base"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "symbols",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Symbols"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "date",
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RatesResponseSchema"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "operationId": "vatcomply_api_root",
        "summary": "API Information",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootResponseSchema"
                }
              }
            }
          }
        },
        "description": "Returns general information about the API, its status, and available endpoints."
      }
    }
  },
